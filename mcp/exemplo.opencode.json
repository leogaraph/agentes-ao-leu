{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "arquivos": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "./docs"],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    }
  },
  "permission": {
    "external_directory": {
      "../compartilhado/**": "allow"
    },
    "read": {
      "../compartilhado/**": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny"
    }
  }
}
